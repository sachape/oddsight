# Copier ce fichier en scraper/.env.local et y mettre ta vraie clé API-Football.
# Récupère la clé sur https://dashboard.api-football.com  (header x-apisports-key)
APIFOOTBALL_KEY=ta_cle_ici

# Optionnel : surcharger l'ID de la compétition et la saison
# APIFOOTBALL_WC_LEAGUE=1
# APIFOOTBALL_SEASON=2026
